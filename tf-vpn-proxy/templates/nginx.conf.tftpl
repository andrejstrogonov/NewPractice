worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile on;
    keepalive_timeout 65;

    upstream keycloak_upstream {
        server keycloak:8080;
    }

    upstream integrity_grpc {
        server integrity-grpc-svc:50051;
    }

    server {
        listen 80;
        server_name ${domain_name};

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl http2;
        server_name ${domain_name};

        ssl_certificate     /etc/nginx/tls/tls.crt;
        ssl_certificate_key /etc/nginx/tls/tls.key;

        location = / {
            return 302 https://${keycloak_hostname}/realms/${keycloak_realm}/protocol/openid-connect/auth?response_type=code&client_id=${keycloak_client};
        }

        location /auth/ {
            proxy_pass http://keycloak_upstream/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /integrity.IntegrityService/ {
            grpc_set_header Host $host;
            grpc_pass grpc://integrity_grpc;
        }

        location /grpc.health.v1.Health/ {
            grpc_set_header Host $host;
            grpc_pass grpc://integrity_grpc;
        }
    }
}
